+  pathPoints?: Cell[];
+}
+
+export interface NetworkPolicy {
+  id: string;
+  name: string;
+  sourceZone: string;
+  destinationZone: string;
+  action: 'allow' | 'deny';
+  protocol: 'any' | 'tcp' | 'udp' | 'icmp';
