# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Datacenter Builder Simulator"

# --- Wallet Connect (Cloud) ---
# Get from https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Server secrets ---
# 32+ char random string
SESSION_SECRET=replace_me_with_32_plus_char_random_string_xxxxxxxxxx
# Domain this app runs on (no protocol)
SESSION_COOKIE_DOMAIN=localhost

# --- Credly (server only) ---
# Create org at https://www.credly.com, then create API token in org settings
CREDLY_API_TOKEN=
CREDLY_ORG_ID=
# Comma-separated list of badge template IDs (one per cert level)
CREDLY_TEMPLATE_BRONZE=
CREDLY_TEMPLATE_SILVER=
CREDLY_TEMPLATE_GOLD=
CREDLY_TEMPLATE_PLATINUM=
# Use Credly test environment
CREDLY_TEST_MODE=true

# --- Email (server only) ---
RESEND_API_KEY=
EMAIL_FROM="Datacenter Builder Simulator <noreply@example.com>"

# --- Telemetry (opt-in) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
