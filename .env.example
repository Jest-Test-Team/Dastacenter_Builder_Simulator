# Session secret (required - generate with: openssl rand -base64 32)
SESSION_SECRET=your-secret-key-here

# WalletConnect Project ID (optional but recommended for mobile wallets)
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=your-walletconnect-project-id

# IPFS Storage (choose one - NFT.Storage is free and recommended for testing)
# NFT.Storage: https://nft.storage (Free)
NEXT_PUBLIC_NFT_STORAGE_KEY=your-nft-storage-api-key

# Pinata (Alternative IPFS provider): https://pinata.cloud
# NEXT_PUBLIC_PINATA_KEY=your-pinata-jwt

# Arweave Storage (optional - for permanent storage)
# Get key from: https://irys.xyz
# NEXT_PUBLIC_ARWEAVE_KEY=your-arweave-key

# SBT Contract Deployment (only needed for deploying contracts)
# PRIVATE_KEY=your-deployer-wallet-private-key
# SBT_MINTER_PRIVATE_KEY=your-server-side-minter-wallet-private-key

# SBT Contract Address Overrides (optional; prefer env over code edits)
# NEXT_PUBLIC_SBT_CONTRACT_ADDRESS_POLYGON_AMOY=0xYourDeployedAmoyContractAddress

# Cert threshold for publishing Web3 certificates
# Lower this for testing, then raise it back before public use.
# NEXT_PUBLIC_CERT_THRESHOLD=40

# RPC URLs (optional - defaults are provided in code)
# POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
# POLYGON_RPC=https://polygon-rpc.com
# SEPOLIA_RPC=https://rpc.sepolia.org
# ETHEREUM_RPC=https://eth.llamarpc.com
# BSC_RPC=https://bsc-dataseed.binance.org
# BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Block Explorer API Keys (for contract verification)
# POLYGONSCAN_API_KEY=your-polygonscan-api-key
# ETHERSCAN_API_KEY=your-etherscan-api-key
# BSCSCAN_API_KEY=your-bscscan-api-key
# ARBISCAN_API_KEY=your-arbiscan-api-key
# OPTIMISM_API_KEY=your-optimism-etherscan-api-key
# BASESCAN_API_KEY=your-basescan-api-key

# Analytics (optional)
# PostHog: https://posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Observability (optional)
# Sentry: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# App URL (for production)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- KSN autonomous settlement agent -----------------------------------------
# The agent's own wallet. Holds the KSN dividend treasury and pays the gas for
# each disbursement. Deliberately NOT the SBT minter key: the party paying the
# dividend is meant to be independent of the party that issued the credential.
KSN_AGENT_PRIVATE_KEY=0x...
# The same wallet's address, read by contracts/scripts/deploy-ksn.js.
KSN_AGENT_ADDRESS=0x...
# Printed by `npm run deploy:ksn -- --network sepolia`. Without it the agent
# reports itself unconfigured rather than pretending to settle.
NEXT_PUBLIC_KSN_TOKEN_ADDRESS_SEPOLIA=0x...
