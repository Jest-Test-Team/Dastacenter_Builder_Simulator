{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datacenter-simulator",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/build",
      "/build/*",
      "/cert/*",
      "/learn/*",
      "/result/*",
      "/sim/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "LEADERBOARD_DB",
      "database_name": "leadeerboard",
      "database_id": "1ff99801-d812-44f2-b2bd-43390a702fc9"
    }
  ],
  // Workers AI powers the Compact tutor in /learn. Grounded Q&A over source
  // excerpts that are already public in this repo — no build data is sent, and
  // there is deliberately no third-party model vendor. See src/lib/ai/.
  "ai": {
    "binding": "AI",
    // Workers AI has no local simulator; `next dev` proxies to the real account
    // binding, which requires `wrangler login`.
    "experimental_remote": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://datacenter-building-simulator.dennisleehappy.org/",
    "NEXT_PUBLIC_WC_PROJECT_ID": "10ab544899577333e1c63767710a9a4b",
    "NEXT_PUBLIC_SBT_CONTRACT_ADDRESS_POLYGON_AMOY": "0x0e6dF52Ffc02095C8AdE30a7B2Fda67a9FFf88eB",
    "NEXT_PUBLIC_SBT_CONTRACT_ADDRESS_SEPOLIA": "0x0e6dF52Ffc02095C8AdE30a7B2Fda67a9FFf88eB",

    // The KSN dividend token, printed by `npm run deploy:ksn -- --network
    // sepolia`. Until it is set the settlement agent halts at `settle` and says
    // the treasury is unconfigured — it never reports a payment it did not make.
    // The agent's signing key is a SECRET, not a var:
    //   wrangler secret put KSN_AGENT_PRIVATE_KEY
    "NEXT_PUBLIC_KSN_TOKEN_ADDRESS_SEPOLIA": "",

    // Accepts MockProver in a deployed environment. Without it getProver()
    // refuses to run in production and /api/zk/prove answers 503, which breaks
    // the demo at the proof step.
    //
    // Mock proofs are NOT sound — they are forgeable, so a certificate minted
    // behind one attests to nothing. This is here to keep the demo flowing, and
    // should be removed the moment a real proof server is reachable via
    // MIDNIGHT_PROOF_SERVER_URL (which takes precedence over this flag).
    // See docs/MIDNIGHT_ZK.md.
    "ZK_ALLOW_MOCK": "true"
  }
}
